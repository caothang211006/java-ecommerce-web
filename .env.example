# Copy to .env and adjust. .env is gitignored -- never commit real credentials.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ProductIntro_WS2_ThangNDC_SE203709
DB_USER=ecommerce
DB_PASSWORD=ecommerce

# Tomcat HTTP port. Hosts such as Railway and Render inject their own PORT.
PORT=8080

# Optional. If your host supplies a single connection string instead of the
# separate variables above, set it here and it takes precedence. Both the
# mysql://user:pass@host:port/db and jdbc:mysql://... forms are understood.
# DATABASE_URL=
